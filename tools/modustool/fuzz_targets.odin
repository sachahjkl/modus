package modustool

import "modus:contract/operation_sequence"

// The fuzz targets (src/md/infrastructure/fuzzing.md, "The targets, in
// order of value"). A new target adds its row here and its folder of corpus
// under tools/modustool/fuzzing_corpus. The important formats have a raw
// target, which reaches the first checks of the reader, and a generated
// target, which reaches the code behind them.

@(private = "file")
fuzz_target_table := [?]Fuzz_Target {
	{
		name = "module_file",
		kind = .Raw,
		about = "contract/module: a file that validate accepts gives no read out of bounds through any reader",
		packages = {SOURCE_FOLDER_CONTRACT + "/module"},
		input_limit = 64 << 10,
		execute = fuzz_module_file_execute,
		seeds = fuzz_module_seeds,
		regions = fuzz_module_regions,
	},
	{
		name = "module_generated",
		kind = .Generated,
		about = "contract/module: a module built by the rules is valid; one broken field, then each reader",
		packages = {SOURCE_FOLDER_CONTRACT + "/module"},
		input_limit = 4 << 10,
		execute = fuzz_module_generated_execute,
	},
	{
		name = "debug_object",
		kind = .Raw,
		about = "contract/debug_object: an object that check accepts gives each reader with no fault, and encodes to the same bytes",
		packages = {SOURCE_FOLDER_CONTRACT + "/debug_object"},
		input_limit = 64 << 10,
		execute = fuzz_debug_object_execute,
		seeds = fuzz_debug_object_seeds,
		regions = fuzz_debug_object_regions,
	},
	{
		name = "debug_object_generated",
		kind = .Generated,
		about = "contract/debug_object: an object built by the rules passes check; one broken field, then each reader",
		packages = {SOURCE_FOLDER_CONTRACT + "/debug_object"},
		input_limit = 4 << 10,
		execute = fuzz_debug_object_generated_execute,
	},
	{
		name = "storage_tree",
		kind = .Generated,
		about = "support/storage_tree: the B-tree against a sorted model, its walk after each commit, then damaged nodes",
		packages = {SOURCE_FOLDER_SUPPORT + "/storage_tree"},
		input_limit = 8 << 10,
		execute = fuzz_storage_tree_execute,
		start = fuzz_storage_tree_start,
		// Up to 300 operations and a walk after each commit in one
		// execution: a long run explores; the check keeps its part short.
		check_executions = 2_000,
	},
	{
		name = "storage_mount",
		kind = .Generated,
		about = "support/storage_mount: the open of a disk gives back each object of its writer, then never a wrong object of a damaged disk",
		packages = {SOURCE_FOLDER_SUPPORT + "/storage_mount", SOURCE_FOLDER_SUPPORT + "/storage_object", SOURCE_FOLDER_SUPPORT + "/storage_tree"},
		input_limit = 4 << 10,
		execute = fuzz_storage_mount_execute,
		start = fuzz_storage_mount_start,
		// Measured: about 120 executions in one second (a whole disk is
		// written and opened two times), so 1000 cost about 8 seconds.
		check_executions = 1_000,
	},
	{
		name = "quic_datagram",
		kind = .Raw,
		about = "support/quic: one datagram to a server that waits for its client: the header reader, the receive, the answer",
		packages = {SOURCE_FOLDER_SUPPORT + "/quic"},
		input_limit = 2 << 10,
		execute = fuzz_quic_datagram_execute,
		seeds = fuzz_quic_datagram_seeds,
		start = fuzz_quic_start,
	},
	{
		name = "quic_connection",
		kind = .Generated,
		about = "support/quic: a client and a server in memory, datagrams changed or resealed with new frames; with no change the handshake completes",
		packages = {SOURCE_FOLDER_SUPPORT + "/quic"},
		input_limit = 4 << 10,
		execute = fuzz_quic_connection_execute,
		start = fuzz_quic_start,
		// Measured: about 120 executions in one second (a whole handshake
		// each), so 1000 cost about 8 seconds.
		check_executions = 1_000,
	},
	{
		name = "tls_messages",
		kind = .Raw,
		about = "support/quic: the messages of TLS 1.3 to a client or to a server, level by level",
		packages = {SOURCE_FOLDER_SUPPORT + "/quic"},
		input_limit = 8 << 10,
		execute = fuzz_tls_messages_execute,
		seeds = fuzz_tls_messages_seeds,
		start = fuzz_quic_start,
		check_executions = 5_000,
	},
	{
		name = "quic_transport_parameters",
		kind = .Raw,
		about = "support/quic: the transport parameters that the reader accepts write and read again to the same record",
		packages = {SOURCE_FOLDER_SUPPORT + "/quic"},
		input_limit = 1 << 10,
		execute = fuzz_transport_parameters_execute,
		seeds = fuzz_transport_parameters_seeds,
	},
	{
		name = "tcp_segment",
		kind = .Raw,
		about = "support/tcp: the header reader and its writer agree, and a listening table takes the segment",
		packages = {SOURCE_FOLDER_SUPPORT + "/tcp"},
		input_limit = 1480,
		execute = fuzz_tcp_segment_execute,
		start = fuzz_tcp_start,
	},
	{
		name = "tcp_connection",
		kind = .Generated,
		about = "support/tcp: two tables in memory with injected segments; with no injection the bytes arrive whole and in order",
		packages = {SOURCE_FOLDER_SUPPORT + "/tcp"},
		input_limit = 4 << 10,
		execute = fuzz_tcp_connection_execute,
		start = fuzz_tcp_start,
		check_executions = 5_000,
	},
	{
		name = "http_request",
		kind = .Raw,
		about = "support/web: the reader of a request head: its fields stay in their limits, and the head reads the same from its own bytes",
		packages = {SOURCE_FOLDER_SUPPORT + "/web"},
		input_limit = 16 << 10,
		execute = fuzz_http_request_execute,
		seeds = fuzz_http_request_seeds,
	},
	{
		name = "remote_request",
		kind = .Raw,
		about = "contract/remote: a call request that request_check accepts keeps each place in the call region and writes again to its bytes",
		packages = {SOURCE_FOLDER_CONTRACT + "/remote"},
		input_limit = 4 << 10,
		execute = fuzz_remote_request_execute,
		seeds = fuzz_remote_request_seeds,
	},
	{
		name = "remote_answer",
		kind = .Raw,
		about = "contract/remote: a call answer that answer_check accepts names a status, shows no more details than it holds, and writes again to its bytes",
		packages = {SOURCE_FOLDER_CONTRACT + "/remote"},
		input_limit = 4 << 10,
		execute = fuzz_remote_answer_execute,
		seeds = fuzz_remote_answer_seeds,
	},
	{
		name = "remote_client_table",
		kind = .Raw,
		about = "contract/remote: the client table reads as it is written, and each decision on a key names the right row",
		packages = {SOURCE_FOLDER_CONTRACT + "/remote"},
		input_limit = 1 << 10,
		execute = fuzz_remote_client_table_execute,
		seeds = fuzz_remote_client_table_seeds,
	},
	{
		name = "isolated_call",
		kind = .Raw,
		about = "contract/isolated: decode of a description and a call region gives only slices inside the call region",
		packages = {SOURCE_FOLDER_CONTRACT + "/isolated"},
		input_limit = FUZZ_CALL_DESCRIPTION_SIZE + FUZZ_CALL_REGION_LIMIT,
		execute = fuzz_isolated_call_execute,
		seeds = fuzz_isolated_call_seeds,
		start = fuzz_isolated_call_start,
	},
	{
		name = "ring_records",
		kind = .Raw,
		about = "the records of a ring: each event, input, service command and root command is a member that its word names, or a refusal",
		packages = {SOURCE_FOLDER_SUPPORT + "/display", SOURCE_FOLDER_SUPPORT + "/terminal", SOURCE_FOLDER_SUPPORT + "/system", SOURCE_FOLDER_CONTRACT + "/root_ring", SOURCE_FOLDER_CONTRACT + "/errors"},
		input_limit = FUZZ_RING_RECORDS_INPUT_LIMIT,
		execute = fuzz_ring_records_execute,
		seeds = fuzz_ring_records_seeds,
		regions = fuzz_ring_records_regions,
	},
	{
		name = "root_ring",
		kind = .Raw,
		about = "contract/root_ring: the dispatch of a record stops at the border or the sender with its record, as the table of the senders says, and changes nothing",
		packages = {SOURCE_FOLDER_CONTRACT + "/root_ring", SOURCE_FOLDER_CONTRACT + "/errors"},
		input_limit = FUZZ_ROOT_RING_INPUT_LIMIT,
		execute = fuzz_root_ring_execute,
		seeds = fuzz_root_ring_seeds,
		regions = fuzz_root_ring_regions,
		start = fuzz_root_ring_start,
	},
	{
		name = "disk_grant_table",
		kind = .Raw,
		about = "support/disk_program: a table behind its tag holds rows by its rules, and encodes and decodes to its part that persists",
		packages = {SOURCE_FOLDER_SUPPORT + "/disk_program"},
		input_limit = 2 << 10,
		execute = fuzz_disk_grant_table_execute,
		seeds = fuzz_disk_grant_table_seeds,
	},
	{
		name = "system_description",
		kind = .Raw,
		about = "contract/system_description: a description that entries accepts is the one that its writer gives for its entries",
		packages = {SOURCE_FOLDER_CONTRACT + "/system_description", SOURCE_FOLDER_CONTRACT + "/boot_info"},
		input_limit = 16 << 10,
		execute = fuzz_system_description_execute,
		seeds = fuzz_system_description_seeds,
	},
	{
		name = "boot_image_generated",
		kind = .Generated,
		about = "contract/system_description: a boot image as built passes the checks; a changed byte of a file or of the description fails them",
		packages = {SOURCE_FOLDER_CONTRACT + "/system_description", SOURCE_FOLDER_CONTRACT + "/boot_info"},
		input_limit = 4 << 10,
		execute = fuzz_boot_image_generated_execute,
		// Each execution writes a whole boot image of up to seven pages and
		// hashes each file.
		check_executions = 5_000,
	},
	{
		name = "vector_font",
		kind = .Raw,
		about = "support/vector_font: a font that font_open accepts gives each glyph, outline, pair and substitution, and draws a glyph",
		packages = {SOURCE_FOLDER_SUPPORT + "/vector_font"},
		input_limit = 64 << 10,
		execute = fuzz_vector_font_execute,
		seeds = fuzz_vector_font_seeds,
		start = fuzz_vector_font_start,
		// Each execution of a whole font reads the outlines of 94
		// characters and draws one.
		check_executions = 5_000,
	},
	{
		name = "glyph_cache",
		kind = .Raw,
		about = "contract/glyph_cache: a cache that validate accepts gives each glyph with its rows in its line and its words in the file",
		packages = {SOURCE_FOLDER_CONTRACT + "/glyph_cache"},
		input_limit = 64 << 10,
		execute = fuzz_glyph_cache_execute,
		seeds = fuzz_glyph_cache_seeds,
		regions = fuzz_glyph_cache_regions,
	},
	{
		name = "font_outlines",
		kind = .Raw,
		about = "contract/font_outlines: a resource that validate accepts gives its font files, and its fonts write again to a resource with the same fonts",
		packages = {SOURCE_FOLDER_CONTRACT + "/font_outlines"},
		input_limit = 4 << 10,
		execute = fuzz_font_outlines_execute,
		seeds = fuzz_font_outlines_seeds,
		regions = fuzz_font_outlines_regions,
	},
	{
		name = "pointer_pictures",
		kind = .Raw,
		about = "contract/pointer_pictures: a theme that validate accepts gives a picture of each shape, size and time with its pixels in the file",
		packages = {SOURCE_FOLDER_CONTRACT + "/pointer_pictures"},
		input_limit = 8 << 10,
		execute = fuzz_pointer_pictures_execute,
		seeds = fuzz_pointer_pictures_seeds,
		regions = fuzz_pointer_pictures_regions,
	},
	{
		name = "firmware_tables",
		kind = .Raw,
		about = "kernel:iommu: the tables DMAR, IVRS and MCFG that the readers accept keep their counts, ranges and units in their bounds",
		packages = {SOURCE_FOLDER_KERNEL + "/iommu"},
		input_limit = 4 << 10,
		execute = fuzz_firmware_tables_execute,
		seeds = fuzz_firmware_tables_seeds,
	},
	{
		name = "acpi_processors",
		kind = .Raw,
		about = "kernel:acpi_processors: the processors of the table APIC stay in their table, and the mode of 8 bits names a part of the other mode",
		packages = {SOURCE_FOLDER_KERNEL + "/acpi_processors"},
		input_limit = FUZZ_ACPI_PROCESSORS_INPUT_LIMIT,
		execute = fuzz_acpi_processors_execute,
		seeds = fuzz_acpi_processors_seeds,
	},
	{
		name = "sentences",
		kind = .Raw,
		about = "support/sentence: the sentence of any error record is a valid text, and in a small buffer it is its start and the cut mark",
		packages = {SOURCE_FOLDER_SUPPORT + "/sentence", SOURCE_FOLDER_CONTRACT + "/cut_mark"},
		input_limit = FUZZ_SENTENCES_INPUT_LIMIT,
		execute = fuzz_sentences_execute,
		seeds = fuzz_sentences_seeds,
		regions = fuzz_sentences_regions,
	},
	{
		name = "palette_table",
		kind = .Raw,
		about = "contract/palette_table: the copies of the entries, the result and the candidates hold what the checks accept, and an argument packs again to itself",
		packages = {SOURCE_FOLDER_CONTRACT + "/palette_table"},
		input_limit = 32 << 10,
		execute = fuzz_palette_table_execute,
		seeds = fuzz_palette_table_seeds,
		regions = fuzz_palette_table_regions,
		start = fuzz_palette_table_start,
	},
	{
		name = "demand_cache",
		kind = .Raw,
		about = "contract/demand_cache: an entry that find gives is of its face and its frame and reads words of the cache only; the writer publishes it again",
		packages = {SOURCE_FOLDER_CONTRACT + "/demand_cache"},
		input_limit = FUZZ_DEMAND_INPUT_LIMIT,
		execute = fuzz_demand_cache_execute,
		seeds = fuzz_demand_cache_seeds,
		regions = fuzz_demand_cache_regions,
		start = fuzz_demand_cache_start,
	},
	{
		name = "value_runs",
		kind = .Raw,
		about = "contract/value_kinds: the runs that the check accepts write again to themselves, and their parts in the records are the runs cut at the bounds",
		packages = {SOURCE_FOLDER_CONTRACT + "/value_kinds"},
		input_limit = FUZZ_VALUE_RUNS_INPUT_LIMIT,
		execute = fuzz_value_runs_execute,
		seeds = fuzz_value_runs_seeds,
		regions = fuzz_value_runs_regions,
	},
	{
		name = "text_encoding",
		kind = .Raw,
		about = "contract/text_encoding: the check agrees with the reader of the Odin library, and each character encodes to its bytes",
		packages = {SOURCE_FOLDER_CONTRACT + "/text_encoding"},
		input_limit = 4 << 10,
		execute = fuzz_text_encoding_execute,
		seeds = fuzz_text_encoding_seeds,
	},
	{
		name = "kept_stop_reports",
		kind = .Generated,
		about = "support/disk_program: a hidden stop report names no hidden value, and the kept reports follow their model",
		packages = {SOURCE_FOLDER_SUPPORT + "/disk_program"},
		input_limit = 4 << 10,
		execute = fuzz_kept_stop_reports_execute,
	},
	{
		name = "kept_settings",
		kind = .Raw,
		about = "contract/settings: the kept record, the text of a zone and the page read as valid values, and write again to them",
		packages = {SOURCE_FOLDER_CONTRACT + "/settings"},
		input_limit = 256,
		execute = fuzz_kept_settings_execute,
		seeds = fuzz_kept_settings_seeds,
		regions = fuzz_kept_settings_regions,
	},
	{
		name = "tpm_answers",
		kind = .Raw,
		about = "support/tpm2: each reader of an answer agrees with its header, gives no value on a refusal, and slices inside the answer",
		packages = {SOURCE_FOLDER_SUPPORT + "/tpm2"},
		input_limit = 1 << 10,
		execute = fuzz_tpm_answers_execute,
		seeds = fuzz_tpm_answers_seeds,
	},
	{
		name = "text_shaping",
		kind = .Raw,
		about = "support/text_shaping: one placed glyph for each character, at its byte, with the advance of its table and its pair",
		packages = {SOURCE_FOLDER_SUPPORT + "/text_shaping"},
		input_limit = FUZZ_SHAPING_INPUT_LIMIT,
		execute = fuzz_text_shaping_execute,
		seeds = fuzz_text_shaping_seeds,
		regions = fuzz_text_shaping_regions,
		start = fuzz_text_shaping_start,
	},
	{
		name = "operation_sequence",
		kind = .Raw,
		about = "contract/operation_sequence: a sequence that check accepts follows each rule of its format and writes again to its bytes; a refusal names its step, its area or its argument",
		packages = {SOURCE_FOLDER_CONTRACT + "/operation_sequence"},
		input_limit = operation_sequence.SEQUENCE_BYTES_MOST + 1,
		execute = fuzz_operation_sequence_execute,
		seeds = fuzz_operation_sequence_seeds,
		regions = fuzz_operation_sequence_regions,
	},
	{
		name = "operation_sequence_generated",
		kind = .Generated,
		about = "contract/operation_sequence: each sequence that the generator builds from the forms of OPERATIONS is one that check accepts and reads back whole",
		packages = {SOURCE_FOLDER_CONTRACT + "/operation_sequence"},
		input_limit = 16 << 10,
		execute = fuzz_operation_sequence_generated_execute,
		start = fuzz_operation_sequence_start,
	},
}

fuzz_targets :: proc() -> []Fuzz_Target {
	return fuzz_target_table[:]
}

fuzz_target_find :: proc(targets: []Fuzz_Target, name: string) -> (target: ^Fuzz_Target, found: bool) {
	for &item in targets {
		if item.name == name {
			return &item, true
		}
	}
	return nil, false
}
