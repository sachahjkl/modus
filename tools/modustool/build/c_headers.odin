// c_headers_generate writes all five deterministic C11 contract headers into
// output_dir, creating output_dir when absent. Returns "" on success or a
// plain-English problem string on failure.
c_headers_generate :: proc(output_dir: string) -> (problem: string) {
	trimmed := strings.trim_space(output_dir)
	if trimmed == "" {
		return "output directory path is empty"
	}
	target_dir := strings.trim_right(trimmed, "/")
	if target_dir == "" {
		return "output directory path must not be root"
	}
	if !foundation.make_folder(target_dir) {
		return fmt.tprintf("cannot create C headers output directory `%s`", target_dir)
	}

	Header_Entry :: struct {
		name: string,
		body: string,
	}
	headers := [?]Header_Entry {
		{"modus_types.h", c_render_modus_types_h(context.temp_allocator)},
		{"modus_operation.h", c_render_modus_operation_h(context.temp_allocator)},
		{"modus_errors.h", c_render_modus_errors_h(context.temp_allocator)},
		{"modus_call_outcome.h", c_render_modus_call_outcome_h(context.temp_allocator)},
		{"modus_ring.h", c_render_modus_ring_h(context.temp_allocator)},
		{"modus_module.h", c_render_modus_module_h(context.temp_allocator)},
	}
	for item in headers {
		dest := foundation.join(target_dir, "/", item.name)
		if write_err := os.write_entire_file(dest, item.body); write_err != nil {
			return fmt.tprintf("cannot write C header `%s`: %v", dest, write_err)
		}
	}
	return ""
}

// run_c_headers implements `modustool c-headers <output-dir>`.
run_c_headers :: proc(args: []string) -> int {
	if len(args) != 1 || strings.has_prefix(args[0], "--") {
		fmt.eprintln(C_HEADERS_USAGE)
		return foundation.EXIT_USAGE
	}
	output_dir := args[0]
	if problem := c_headers_generate(output_dir); problem != "" {
		fmt.eprintfln("modustool: c-headers: %s", problem)
		return foundation.EXIT_FAILURE
	}
	fmt.printfln("modustool: c-headers: wrote %d C11 headers for release %s in %s", len(C_HEADER_FILE_NAMES), release.RELEASE_NUMBER, output_dir)
	return 0
}
