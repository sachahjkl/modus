// C11 header generator for modus SDK releases (src/md/infrastructure/sdk.md).
//
// Generates six self-contained C11 headers directly from the Odin contract
// packages, deriving every enum value, constant, struct size, and field offset
// from the Odin compiler itself via size_of and offset_of:
//
//   modus_types.h      fundamental fixed-width types, release metadata, value kinds
//   modus_operation.h  kernel operations, statuses, handles, rights, and ABI records
//   modus_errors.h     structured error records, kinds, units, and handle ends
//   modus_call_outcome.h  the call outcome, its effect group, and the answer pair
//   modus_ring.h       shared-memory ring queues, headers, and record layout
//   modus_module.h     module binary format version 7 tables and descriptions
package build

import "core:fmt"
import "core:os"
import "core:strings"
import "modus:contract/call_outcome"
import "modus:contract/errors"
import module "modus:contract/module"
import op "modus:contract/operation"
import "modus:contract/release"
import "modus:contract/ring"
import "modus:contract/value_kinds"
import "modustool:foundation"

C_HEADERS_USAGE :: "modustool: c-headers <output-dir>"

// Canonical list of generated C11 header files in deterministic order.
C_HEADER_FILE_NAMES :: [?]string {
	"modus_types.h",
	"modus_operation.h",
	"modus_errors.h",
	"modus_call_outcome.h",
	"modus_ring.h",
	"modus_module.h",
}

@(private = "file")
c_header_begin :: proc(out: ^strings.Builder, guard: string, title: string, includes: []string) {
	fmt.sbprintfln(out, "/*")
	fmt.sbprintfln(out, " * %s", title)
	fmt.sbprintfln(out, " * Generated by modustool c-headers for modus release %s.", release.RELEASE_NUMBER)
	fmt.sbprintfln(out, " * Do not edit by hand; regenerate from the Odin contract packages.")
	fmt.sbprintfln(out, " */")
	fmt.sbprintfln(out, "#ifndef %s", guard)
	fmt.sbprintfln(out, "#define %s", guard)
	fmt.sbprintln(out)
	for inc in includes {
		fmt.sbprintfln(out, "#include %s", inc)
	}
	fmt.sbprintln(out)
	fmt.sbprintln(out, "#ifdef __cplusplus")
	fmt.sbprintln(out, "extern \"C\" {")
	fmt.sbprintln(out, "#endif")
	fmt.sbprintln(out)
}

@(private = "file")
c_header_end :: proc(out: ^strings.Builder, guard: string) {
	fmt.sbprintln(out, "#ifdef __cplusplus")
	fmt.sbprintln(out, "}")
	fmt.sbprintln(out, "#endif")
	fmt.sbprintln(out)
	fmt.sbprintfln(out, "#endif /* %s */", guard)
}

@(private = "file")
c_emit_size_assert :: proc(out: ^strings.Builder, c_type: string, expected_size: int) {
	fmt.sbprintfln(out, "_Static_assert(sizeof(%s) == %dU, \"%s size must match Odin contract\");", c_type, expected_size, c_type)
}

@(private = "file")
c_emit_offset_assert :: proc(out: ^strings.Builder, c_type: string, c_field: string, expected_offset: uintptr) {
	fmt.sbprintfln(out, "_Static_assert(offsetof(%s, %s) == %dU, \"%s.%s offset must match Odin contract\");", c_type, c_field, int(expected_offset), c_type, c_field)
}

@(private = "file")
c_emit_enum_u8 :: proc(out: ^strings.Builder, c_type: string, prefix: string, $E: typeid) {
	fmt.sbprintfln(out, "typedef uint8_t %s;", c_type)
	c_emit_size_assert(out, c_type, size_of(E))
	for member in E {
		upper := strings.to_upper(fmt.tprintf("%v", member), context.temp_allocator)
		fmt.sbprintfln(out, "#define %s_%s ((%s)%dU)", prefix, upper, c_type, u8(member))
	}
	fmt.sbprintln(out)
}

@(private = "file")
c_emit_enum_u32 :: proc(out: ^strings.Builder, c_type: string, prefix: string, $E: typeid) {
	fmt.sbprintfln(out, "typedef uint32_t %s;", c_type)
	c_emit_size_assert(out, c_type, size_of(E))
	for member in E {
		upper := strings.to_upper(fmt.tprintf("%v", member), context.temp_allocator)
		fmt.sbprintfln(out, "#define %s_%s ((%s)%dU)", prefix, upper, c_type, u32(member))
	}
	fmt.sbprintln(out)
}

@(private = "file")
c_emit_enum_u64 :: proc(out: ^strings.Builder, c_type: string, prefix: string, $E: typeid) {
	fmt.sbprintfln(out, "typedef uint64_t %s;", c_type)
	c_emit_size_assert(out, c_type, size_of(E))
	for member in E {
		upper := strings.to_upper(fmt.tprintf("%v", member), context.temp_allocator)
		fmt.sbprintfln(out, "#define %s_%s ((%s)%dULL)", prefix, upper, c_type, u64(member))
	}
	fmt.sbprintln(out)
}

@(private = "file")
c_emit_enum_i64 :: proc(out: ^strings.Builder, c_type: string, prefix: string, $E: typeid) {
	fmt.sbprintfln(out, "typedef int64_t %s;", c_type)
	c_emit_size_assert(out, c_type, size_of(E))
	for member in E {
		upper := strings.to_upper(fmt.tprintf("%v", member), context.temp_allocator)
		fmt.sbprintfln(out, "#define %s_%s ((%s)%dLL)", prefix, upper, c_type, i64(member))
	}
	fmt.sbprintln(out)
}

@(private = "file")
c_render_modus_types_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_TYPES_H", "modus_types.h - Fundamental C11 contract types for modus", {"<stdbool.h>", "<stddef.h>", "<stdint.h>"})

	fmt.sbprintfln(&out, "#define MODUS_RELEASE_NUMBER \"%s\"", release.RELEASE_NUMBER)
	fmt.sbprintfln(&out, "#define MODUS_PAGE_SIZE ((uint64_t)%dULL)", op.PAGE_SIZE)
	fmt.sbprintfln(&out, "#define MODUS_HASH_SIZE ((uint32_t)%dU)", module.HASH_SIZE)
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef uint32_t Modus_Handle;")
	c_emit_size_assert(&out, "Modus_Handle", size_of(op.Handle))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef uint32_t Modus_Rights;")
	c_emit_size_assert(&out, "Modus_Rights", size_of(op.Rights))
	fmt.sbprintln(&out)

	fmt.sbprintfln(&out, "typedef uint8_t Modus_Hash[%d];", module.HASH_SIZE)
	c_emit_size_assert(&out, "Modus_Hash", module.HASH_SIZE)
	fmt.sbprintln(&out)

	c_emit_enum_u8(&out, "Modus_Value_Kind", "MODUS_VALUE_KIND", value_kinds.Value_Kind)
	c_emit_enum_u8(&out, "Modus_Size_Unit", "MODUS_SIZE_UNIT", value_kinds.Size_Unit)
	c_emit_enum_u8(&out, "Modus_Duration_Unit", "MODUS_DURATION_UNIT", value_kinds.Duration_Unit)
	c_emit_enum_u8(&out, "Modus_Field_Kind", "MODUS_FIELD_KIND", value_kinds.Field_Kind)

	fmt.sbprintln(&out, "typedef struct Modus_Integer_Unit {")
	fmt.sbprintln(&out, "\tModus_Value_Kind kind;")
	fmt.sbprintln(&out, "\tuint8_t unit;")
	fmt.sbprintln(&out, "} Modus_Integer_Unit;")
	c_emit_size_assert(&out, "Modus_Integer_Unit", size_of(value_kinds.Integer_Unit))
	c_emit_offset_assert(&out, "Modus_Integer_Unit", "kind", offset_of(value_kinds.Integer_Unit, kind))
	c_emit_offset_assert(&out, "Modus_Integer_Unit", "unit", offset_of(value_kinds.Integer_Unit, unit))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Value_Run {")
	fmt.sbprintln(&out, "\tuint8_t start;")
	fmt.sbprintln(&out, "\tuint8_t length;")
	fmt.sbprintln(&out, "\tuint8_t kind;")
	fmt.sbprintln(&out, "} Modus_Value_Run;")
	c_emit_size_assert(&out, "Modus_Value_Run", size_of(value_kinds.Value_Run))
	c_emit_offset_assert(&out, "Modus_Value_Run", "start", offset_of(value_kinds.Value_Run, start))
	c_emit_offset_assert(&out, "Modus_Value_Run", "length", offset_of(value_kinds.Value_Run, length))
	c_emit_offset_assert(&out, "Modus_Value_Run", "kind", offset_of(value_kinds.Value_Run, kind))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Value_Run_In_Call {")
	fmt.sbprintln(&out, "\tuint16_t start;")
	fmt.sbprintln(&out, "\tuint16_t length;")
	fmt.sbprintln(&out, "\tuint8_t kind;")
	fmt.sbprintln(&out, "\tuint8_t reserved;")
	fmt.sbprintln(&out, "} Modus_Value_Run_In_Call;")
	c_emit_size_assert(&out, "Modus_Value_Run_In_Call", size_of(value_kinds.Value_Run_In_Call))
	c_emit_offset_assert(&out, "Modus_Value_Run_In_Call", "start", offset_of(value_kinds.Value_Run_In_Call, start))
	c_emit_offset_assert(&out, "Modus_Value_Run_In_Call", "length", offset_of(value_kinds.Value_Run_In_Call, length))
	c_emit_offset_assert(&out, "Modus_Value_Run_In_Call", "kind", offset_of(value_kinds.Value_Run_In_Call, kind))
	c_emit_offset_assert(&out, "Modus_Value_Run_In_Call", "reserved", offset_of(value_kinds.Value_Run_In_Call, reserved))
	fmt.sbprintln(&out)

	c_header_end(&out, "MODUS_TYPES_H")
	return strings.to_string(out)
}

// The call outcome of an export that can fail, in the words of C. The export
// gives the pair Modus_Answer: the outcome in rax, the value in rdx, as the
// System V ABI returns a structure of two 8-byte integers
// (src/md/api/call_outcome.md).
@(private = "file")
c_render_modus_call_outcome_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_CALL_OUTCOME_H", "modus_call_outcome.h - The call outcome of an export that can fail", {"\"modus_types.h\""})

	c_emit_enum_u64(&out, "Modus_Call_Outcome", "MODUS_CALL_OUTCOME", call_outcome.Call_Outcome)
	c_emit_enum_u8(&out, "Modus_Effect_Group", "MODUS_EFFECT_GROUP", call_outcome.Effect_Group)

	fmt.sbprintln(&out, "static inline Modus_Effect_Group modus_effect_group_of(Modus_Call_Outcome outcome) {")
	fmt.sbprintln(&out, "\tswitch (outcome) {")
	for outcome in call_outcome.Call_Outcome {
		outcome_name := strings.to_upper(fmt.tprintf("%v", outcome), context.temp_allocator)
		group_name := strings.to_upper(fmt.tprintf("%v", call_outcome.EFFECT_GROUP_OF[outcome]), context.temp_allocator)
		fmt.sbprintfln(&out, "\tcase MODUS_CALL_OUTCOME_%s: return MODUS_EFFECT_GROUP_%s;", outcome_name, group_name)
	}
	// A word that names no outcome: nobody can tell what the call did.
	fmt.sbprintln(&out, "\tdefault: return MODUS_EFFECT_GROUP_CHANGE_IN_DOUBT;")
	fmt.sbprintln(&out, "\t}")
	fmt.sbprintln(&out, "}")
	fmt.sbprintln(&out)

	// The caller of a binding reads the outcome before the value: the
	// compilers that know the attribute refuse a call that drops the pair.
	fmt.sbprintln(&out, "#if defined(__GNUC__) || defined(__clang__)")
	fmt.sbprintln(&out, "#define MODUS_MUST_READ __attribute__((warn_unused_result))")
	fmt.sbprintln(&out, "#else")
	fmt.sbprintln(&out, "#define MODUS_MUST_READ")
	fmt.sbprintln(&out, "#endif")
	fmt.sbprintln(&out)

	Answer :: struct {
		outcome: call_outcome.Call_Outcome,
		value:   i64,
	}
	fmt.sbprintln(&out, "typedef struct Modus_Answer {")
	fmt.sbprintln(&out, "\tModus_Call_Outcome outcome;")
	fmt.sbprintln(&out, "\tint64_t value;")
	fmt.sbprintln(&out, "} Modus_Answer;")
	c_emit_size_assert(&out, "Modus_Answer", size_of(Answer))
	c_emit_offset_assert(&out, "Modus_Answer", "outcome", offset_of(Answer, outcome))
	c_emit_offset_assert(&out, "Modus_Answer", "value", offset_of(Answer, value))
	fmt.sbprintln(&out)

	c_header_end(&out, "MODUS_CALL_OUTCOME_H")
	return strings.to_string(out)
}

@(private = "file")
c_render_modus_errors_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_ERRORS_H", "modus_errors.h - Structured error record contract for modus", {"\"modus_types.h\""})

	c_emit_enum_i64(&out, "Modus_Error_Kind", "MODUS_ERROR_KIND", errors.Kind)
	c_emit_enum_i64(&out, "Modus_Error_Unit", "MODUS_ERROR_UNIT", errors.Unit)
	c_emit_enum_i64(&out, "Modus_Error_End", "MODUS_ERROR_END", errors.End)
	c_emit_enum_i64(&out, "Modus_Error_Unanswered", "MODUS_ERROR_UNANSWERED", errors.Unanswered)

	fmt.sbprintln(&out, "typedef struct Modus_Error_Record {")
	fmt.sbprintln(&out, "\tint64_t kind;")
	fmt.sbprintln(&out, "\tint64_t unit;")
	fmt.sbprintln(&out, "\tint64_t operation;")
	fmt.sbprintln(&out, "\tint64_t argument;")
	fmt.sbprintln(&out, "\tint64_t value;")
	fmt.sbprintln(&out, "\tint64_t limit;")
	fmt.sbprintln(&out, "\tint64_t found;")
	fmt.sbprintln(&out, "} Modus_Error_Record;")
	c_emit_size_assert(&out, "Modus_Error_Record", size_of(errors.Error_Record))
	c_emit_offset_assert(&out, "Modus_Error_Record", "kind", offset_of(errors.Error_Record, kind))
	c_emit_offset_assert(&out, "Modus_Error_Record", "unit", offset_of(errors.Error_Record, unit))
	c_emit_offset_assert(&out, "Modus_Error_Record", "operation", offset_of(errors.Error_Record, operation))
	c_emit_offset_assert(&out, "Modus_Error_Record", "argument", offset_of(errors.Error_Record, argument))
	c_emit_offset_assert(&out, "Modus_Error_Record", "value", offset_of(errors.Error_Record, value))
	c_emit_offset_assert(&out, "Modus_Error_Record", "limit", offset_of(errors.Error_Record, limit))
	c_emit_offset_assert(&out, "Modus_Error_Record", "found", offset_of(errors.Error_Record, found))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Error_Record_Fact_Fields {")
	fmt.sbprintln(&out, "\tuint64_t kind;")
	fmt.sbprintln(&out, "\tuint64_t unit;")
	fmt.sbprintln(&out, "\tint64_t operation;")
	fmt.sbprintln(&out, "\tint64_t argument;")
	fmt.sbprintln(&out, "\tint64_t value;")
	fmt.sbprintln(&out, "\tint64_t limit;")
	fmt.sbprintln(&out, "\tint64_t found;")
	fmt.sbprintln(&out, "} Modus_Error_Record_Fact_Fields;")
	c_emit_size_assert(&out, "Modus_Error_Record_Fact_Fields", size_of(errors.Error_Record_Fact_Fields))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "kind", offset_of(errors.Error_Record_Fact_Fields, kind))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "unit", offset_of(errors.Error_Record_Fact_Fields, unit))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "operation", offset_of(errors.Error_Record_Fact_Fields, operation))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "argument", offset_of(errors.Error_Record_Fact_Fields, argument))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "value", offset_of(errors.Error_Record_Fact_Fields, value))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "limit", offset_of(errors.Error_Record_Fact_Fields, limit))
	c_emit_offset_assert(&out, "Modus_Error_Record_Fact_Fields", "found", offset_of(errors.Error_Record_Fact_Fields, found))
	fmt.sbprintln(&out)

	c_header_end(&out, "MODUS_ERRORS_H")
	return strings.to_string(out)
}

@(private = "file")
c_render_modus_ring_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_RING_H", "modus_ring.h - Shared-memory ring queues contract for modus", {"\"modus_types.h\""})

	fmt.sbprintfln(&out, "#define MODUS_RING_CAPACITY ((uint32_t)%dU)", ring.CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_RING_PAGE_COUNT ((uint64_t)%dULL)", ring.PAGE_COUNT)
	fmt.sbprintfln(&out, "#define MODUS_RING_CAPACITY_LIMIT ((uint32_t)%dU)", ring.CAPACITY_LIMIT)
	fmt.sbprintfln(&out, "#define MODUS_RING_PAGE_SIZE ((uint64_t)%dULL)", ring.PAGE_SIZE)
	fmt.sbprintfln(&out, "#define MODUS_RING_SHARED_CAPACITY ((uint32_t)%dU)", ring.SHARED_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_RING_SHARED_CAPACITY_LIMIT ((uint32_t)%dU)", ring.SHARED_CAPACITY_LIMIT)
	fmt.sbprintfln(&out, "#define MODUS_RING_TURNS_IN_PAGE ((uint32_t)%dU)", ring.TURNS_IN_PAGE)
	fmt.sbprintfln(&out, "#define MODUS_RING_RECORDS_IN_PAGE ((uint32_t)%dU)", ring.RECORDS_IN_PAGE)
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Ring_Record {")
	fmt.sbprintln(&out, "\tuint32_t kind;")
	fmt.sbprintln(&out, "\tuint32_t tag;")
	fmt.sbprintln(&out, "\tuint64_t values[7];")
	fmt.sbprintln(&out, "} Modus_Ring_Record;")
	c_emit_size_assert(&out, "Modus_Ring_Record", size_of(ring.Record))
	c_emit_offset_assert(&out, "Modus_Ring_Record", "kind", offset_of(ring.Record, kind))
	c_emit_offset_assert(&out, "Modus_Ring_Record", "tag", offset_of(ring.Record, tag))
	c_emit_offset_assert(&out, "Modus_Ring_Record", "values", offset_of(ring.Record, values))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Ring_Counters {")
	fmt.sbprintln(&out, "\tuint32_t write;")
	fmt.sbprintln(&out, "\tuint32_t writer_waits;")
	fmt.sbprintln(&out, "\tuint8_t reserved_0[56];")
	fmt.sbprintln(&out, "\tuint32_t read;")
	fmt.sbprintln(&out, "\tuint32_t reader_waits;")
	fmt.sbprintln(&out, "\tuint8_t reserved_1[56];")
	fmt.sbprintln(&out, "} Modus_Ring_Counters;")
	c_emit_size_assert(&out, "Modus_Ring_Counters", size_of(ring.Counters))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "write", offset_of(ring.Counters, write))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "writer_waits", offset_of(ring.Counters, writer_waits))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "reserved_0", offset_of(ring.Counters, reserved_0))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "read", offset_of(ring.Counters, read))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "reader_waits", offset_of(ring.Counters, reader_waits))
	c_emit_offset_assert(&out, "Modus_Ring_Counters", "reserved_1", offset_of(ring.Counters, reserved_1))
	fmt.sbprintln(&out)

	head_pad := ring.PAGE_SIZE / 2 - size_of(ring.Counters)
	fmt.sbprintln(&out, "typedef struct Modus_Ring_Head {")
	fmt.sbprintln(&out, "\tModus_Ring_Counters commands;")
	fmt.sbprintfln(&out, "\tuint8_t reserved_0[%d];", head_pad)
	fmt.sbprintln(&out, "\tModus_Ring_Counters completions;")
	fmt.sbprintfln(&out, "\tuint8_t reserved_1[%d];", head_pad)
	fmt.sbprintln(&out, "} Modus_Ring_Head;")
	c_emit_size_assert(&out, "Modus_Ring_Head", size_of(ring.Head))
	c_emit_offset_assert(&out, "Modus_Ring_Head", "commands", offset_of(ring.Head, commands))
	c_emit_offset_assert(&out, "Modus_Ring_Head", "reserved_0", offset_of(ring.Head, reserved_0))
	c_emit_offset_assert(&out, "Modus_Ring_Head", "completions", offset_of(ring.Head, completions))
	c_emit_offset_assert(&out, "Modus_Ring_Head", "reserved_1", offset_of(ring.Head, reserved_1))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Ring_Waiters {")
	fmt.sbprintln(&out, "\tuint32_t count;")
	fmt.sbprintln(&out, "\tuint32_t spins;")
	fmt.sbprintln(&out, "\tuint32_t wakes;")
	fmt.sbprintln(&out, "} Modus_Ring_Waiters;")
	c_emit_size_assert(&out, "Modus_Ring_Waiters", size_of(ring.Waiters))
	c_emit_offset_assert(&out, "Modus_Ring_Waiters", "count", offset_of(ring.Waiters, count))
	c_emit_offset_assert(&out, "Modus_Ring_Waiters", "spins", offset_of(ring.Waiters, spins))
	c_emit_offset_assert(&out, "Modus_Ring_Waiters", "wakes", offset_of(ring.Waiters, wakes))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Ring_Shared_Head {")
	fmt.sbprintln(&out, "\tuint32_t write;")
	fmt.sbprintln(&out, "\tuint32_t written;")
	fmt.sbprintln(&out, "\tuint8_t reserved_0[56];")
	fmt.sbprintln(&out, "\tuint32_t read;")
	fmt.sbprintln(&out, "\tuint32_t taken;")
	fmt.sbprintln(&out, "\tuint8_t reserved_1[56];")
	fmt.sbprintln(&out, "\tModus_Ring_Waiters readers;")
	fmt.sbprintln(&out, "\tuint32_t writer_waits;")
	fmt.sbprintln(&out, "\tuint8_t reserved_2[48];")
	fmt.sbprintln(&out, "} Modus_Ring_Shared_Head;")
	c_emit_size_assert(&out, "Modus_Ring_Shared_Head", size_of(ring.Shared_Head))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "write", offset_of(ring.Shared_Head, write))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "written", offset_of(ring.Shared_Head, written))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "reserved_0", offset_of(ring.Shared_Head, reserved_0))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "read", offset_of(ring.Shared_Head, read))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "taken", offset_of(ring.Shared_Head, taken))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "reserved_1", offset_of(ring.Shared_Head, reserved_1))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "readers", offset_of(ring.Shared_Head, readers))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "writer_waits", offset_of(ring.Shared_Head, writer_waits))
	c_emit_offset_assert(&out, "Modus_Ring_Shared_Head", "reserved_2", offset_of(ring.Shared_Head, reserved_2))
	fmt.sbprintln(&out)

	c_header_end(&out, "MODUS_RING_H")
	return strings.to_string(out)
}

@(private = "file")
c_render_modus_operation_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_OPERATION_H", "modus_operation.h - Kernel operations and ABI records for modus", {"\"modus_types.h\"", "\"modus_errors.h\""})

	fmt.sbprintfln(&out, "#define MODUS_WAIT_FOREVER ((uint64_t)0x%016XULL)", op.WAIT_FOREVER)
	fmt.sbprintfln(&out, "#define MODUS_PROCESS_BASE ((uint64_t)0x%016XULL)", u64(op.PROCESS_BASE))
	fmt.sbprintfln(&out, "#define MODUS_CHOSEN_BASE ((uint64_t)0x%016XULL)", u64(op.CHOSEN_BASE))
	fmt.sbprintfln(&out, "#define MODUS_MODULE_BASE ((uint64_t)0x%016XULL)", u64(op.MODULE_BASE))
	fmt.sbprintfln(&out, "#define MODUS_STACK_TOP ((uint64_t)0x%016XULL)", u64(op.STACK_TOP))
	fmt.sbprintfln(&out, "#define MODUS_STACK_PAGES ((uint64_t)%dULL)", op.STACK_PAGES)
	fmt.sbprintfln(&out, "#define MODUS_THREAD_STACK_PAGES ((uint64_t)%dULL)", op.THREAD_STACK_PAGES)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_ADDRESS ((uint64_t)0x%016XULL)", u64(op.CONTEXT_ADDRESS))
	fmt.sbprintfln(&out, "#define MODUS_THREAD_AREA_BASE ((uint64_t)0x%016XULL)", u64(op.THREAD_AREA_BASE))
	fmt.sbprintfln(&out, "#define MODUS_THREAD_AREA_PAGES ((uint64_t)%dULL)", op.THREAD_AREA_PAGES)
	fmt.sbprintfln(&out, "#define MODUS_THREAD_CAPACITY ((uint32_t)%dU)", op.THREAD_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_TIME_ADDRESS ((uint64_t)0x%016XULL)", u64(op.TIME_ADDRESS))
	fmt.sbprintfln(&out, "#define MODUS_USER_END ((uint64_t)0x%016XULL)", u64(op.USER_END))
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_HANDLES ((uint32_t)%dU)", op.CONTEXT_HANDLES)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_VALUES ((uint32_t)%dU)", op.CONTEXT_VALUES)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_LOG ((uint32_t)%dU)", op.CONTEXT_LOG)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_VALUE_SEED ((uint32_t)%dU)", op.CONTEXT_VALUE_SEED)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_VALUE_SEED_COUNT ((uint32_t)%dU)", op.CONTEXT_VALUE_SEED_COUNT)
	fmt.sbprintfln(&out, "#define MODUS_CONTEXT_VALUE_SEED_STRENGTH ((uint32_t)%dU)", op.CONTEXT_VALUE_SEED_STRENGTH)
	fmt.sbprintfln(&out, "#define MODUS_WORD_WAIT_CAPACITY ((uint32_t)%dU)", op.WORD_WAIT_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_FAULT_RECORD_CAPACITY ((uint32_t)%dU)", op.FAULT_RECORD_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_PROCESS_MODULE_CAPACITY ((uint32_t)%dU)", op.PROCESS_MODULE_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_STOP_FRAME_CAPACITY ((uint32_t)%dU)", op.STOP_FRAME_CAPACITY)
	fmt.sbprintln(&out, "#define MODUS_RIGHT_BIT(right) ((Modus_Rights)(1U << (right)))")
	fmt.sbprintln(&out)

	c_emit_enum_u32(&out, "Modus_Right", "MODUS_RIGHT", op.Right)
	c_emit_enum_u8(&out, "Modus_Object_Kind", "MODUS_OBJECT_KIND", op.Object_Kind)
	c_emit_enum_u32(&out, "Modus_Operation", "MODUS_OPERATION", op.Operation)
	c_emit_enum_u32(&out, "Modus_Status", "MODUS_STATUS", op.Status)
	c_emit_enum_u32(&out, "Modus_Process_State", "MODUS_PROCESS_STATE", op.Process_State)
	c_emit_enum_u32(&out, "Modus_Stop_Cause", "MODUS_STOP_CAUSE", op.Stop_Cause)
	c_emit_enum_u32(&out, "Modus_Stop_Outcome", "MODUS_STOP_OUTCOME", op.Stop_Outcome)
	c_emit_enum_u32(&out, "Modus_Strategy", "MODUS_STRATEGY", op.Strategy)
	c_emit_enum_u64(&out, "Modus_Memory_Flag", "MODUS_MEMORY_FLAG", op.Memory_Flag)
	c_emit_enum_u64(&out, "Modus_Map_Flag", "MODUS_MAP_FLAG", op.Map_Flag)
	c_emit_enum_u64(&out, "Modus_Commit_Flag", "MODUS_COMMIT_FLAG", op.Commit_Flag)
	c_emit_enum_u64(&out, "Modus_Device_Kind", "MODUS_DEVICE_KIND", op.Device_Kind)
	c_emit_enum_u64(&out, "Modus_Inspect_Kind", "MODUS_INSPECT_KIND", op.Inspect_Kind)
	c_emit_enum_u64(&out, "Modus_Fault_Kind", "MODUS_FAULT_KIND", op.Fault_Kind)
	c_emit_enum_u64(&out, "Modus_Fault_Handler_Action", "MODUS_FAULT_HANDLER_ACTION", op.Fault_Handler_Action)
	c_emit_enum_u64(&out, "Modus_Fault_Answer_Kind", "MODUS_FAULT_ANSWER_KIND", op.Fault_Answer_Kind)
	c_emit_enum_u8(&out, "Modus_Log_Level", "MODUS_LOG_LEVEL", op.Log_Level)
	c_emit_enum_u8(&out, "Modus_Log_Record_Form", "MODUS_LOG_RECORD_FORM", op.Log_Record_Form)
	c_emit_enum_u8(&out, "Modus_Seed_Strength", "MODUS_SEED_STRENGTH", op.Seed_Strength)
	c_emit_enum_u64(&out, "Modus_Module_Writer", "MODUS_MODULE_WRITER", op.Module_Writer)

	fmt.sbprintln(&out, "typedef struct Modus_Time_Record {")
	fmt.sbprintln(&out, "\tuint64_t milliseconds;")
	fmt.sbprintln(&out, "\tuint64_t cycle_frequency;")
	fmt.sbprintln(&out, "\tuint64_t cycle_start;")
	fmt.sbprintln(&out, "} Modus_Time_Record;")
	c_emit_size_assert(&out, "Modus_Time_Record", size_of(op.Time_Record))
	c_emit_offset_assert(&out, "Modus_Time_Record", "milliseconds", offset_of(op.Time_Record, milliseconds))
	c_emit_offset_assert(&out, "Modus_Time_Record", "cycle_frequency", offset_of(op.Time_Record, cycle_frequency))
	c_emit_offset_assert(&out, "Modus_Time_Record", "cycle_start", offset_of(op.Time_Record, cycle_start))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Budget_Amounts {")
	fmt.sbprintln(&out, "\tuint64_t pages;")
	fmt.sbprintln(&out, "\tuint64_t processes;")
	fmt.sbprintln(&out, "\tuint64_t threads;")
	fmt.sbprintln(&out, "\tuint64_t processor;")
	fmt.sbprintln(&out, "\tuint64_t log_records;")
	fmt.sbprintln(&out, "} Modus_Budget_Amounts;")
	c_emit_size_assert(&out, "Modus_Budget_Amounts", size_of(op.Budget_Amounts))
	c_emit_offset_assert(&out, "Modus_Budget_Amounts", "pages", offset_of(op.Budget_Amounts, pages))
	c_emit_offset_assert(&out, "Modus_Budget_Amounts", "processes", offset_of(op.Budget_Amounts, processes))
	c_emit_offset_assert(&out, "Modus_Budget_Amounts", "threads", offset_of(op.Budget_Amounts, threads))
	c_emit_offset_assert(&out, "Modus_Budget_Amounts", "processor", offset_of(op.Budget_Amounts, processor))
	c_emit_offset_assert(&out, "Modus_Budget_Amounts", "log_records", offset_of(op.Budget_Amounts, log_records))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Word {")
	fmt.sbprintln(&out, "\tuint64_t address;")
	fmt.sbprintln(&out, "\tuint64_t value;")
	fmt.sbprintln(&out, "} Modus_Word;")
	c_emit_size_assert(&out, "Modus_Word", size_of(op.Word))
	c_emit_offset_assert(&out, "Modus_Word", "address", offset_of(op.Word, address))
	c_emit_offset_assert(&out, "Modus_Word", "value", offset_of(op.Word, value))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Page_Range {")
	fmt.sbprintln(&out, "\tuint64_t first;")
	fmt.sbprintln(&out, "\tuint64_t page_count;")
	fmt.sbprintln(&out, "} Modus_Page_Range;")
	c_emit_size_assert(&out, "Modus_Page_Range", size_of(op.Page_Range))
	c_emit_offset_assert(&out, "Modus_Page_Range", "first", offset_of(op.Page_Range, first))
	c_emit_offset_assert(&out, "Modus_Page_Range", "page_count", offset_of(op.Page_Range, page_count))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Address_Range {")
	fmt.sbprintln(&out, "\tuint64_t address;")
	fmt.sbprintln(&out, "\tuint64_t page_count;")
	fmt.sbprintln(&out, "} Modus_Address_Range;")
	c_emit_size_assert(&out, "Modus_Address_Range", size_of(op.Address_Range))
	c_emit_offset_assert(&out, "Modus_Address_Range", "address", offset_of(op.Address_Range, address))
	c_emit_offset_assert(&out, "Modus_Address_Range", "page_count", offset_of(op.Address_Range, page_count))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Fault_Record {")
	fmt.sbprintln(&out, "\tuint64_t thread;")
	fmt.sbprintln(&out, "\tuint64_t serial;")
	fmt.sbprintln(&out, "\tuint64_t address;")
	fmt.sbprintln(&out, "\tuint64_t access;")
	fmt.sbprintln(&out, "\tuint64_t instruction;")
	fmt.sbprintln(&out, "\tuint64_t kind;")
	fmt.sbprintln(&out, "\tuint64_t error_code;")
	fmt.sbprintln(&out, "\tuint64_t reserved;")
	fmt.sbprintln(&out, "} Modus_Fault_Record;")
	c_emit_size_assert(&out, "Modus_Fault_Record", size_of(op.Fault_Record))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "thread", offset_of(op.Fault_Record, thread))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "serial", offset_of(op.Fault_Record, serial))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "address", offset_of(op.Fault_Record, address))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "access", offset_of(op.Fault_Record, access))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "instruction", offset_of(op.Fault_Record, instruction))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "kind", offset_of(op.Fault_Record, kind))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "error_code", offset_of(op.Fault_Record, error_code))
	c_emit_offset_assert(&out, "Modus_Fault_Record", "reserved", offset_of(op.Fault_Record, reserved))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Thread_Record {")
	fmt.sbprintln(&out, "\tuint64_t self;")
	fmt.sbprintln(&out, "\tuint64_t parameter;")
	fmt.sbprintln(&out, "\tuint64_t number;")
	fmt.sbprintln(&out, "\tuint32_t events;")
	fmt.sbprintln(&out, "\tuint32_t processors;")
	fmt.sbprintln(&out, "\tuint32_t fault_written;")
	fmt.sbprintln(&out, "\tuint32_t fault_read;")
	fmt.sbprintln(&out, "\tuint32_t fault_full;")
	fmt.sbprintln(&out, "\tuint32_t fault_reserved;")
	fmt.sbprintfln(&out, "\tModus_Fault_Record fault_records[%d];", op.FAULT_RECORD_CAPACITY)
	fmt.sbprintln(&out, "} Modus_Thread_Record;")
	c_emit_size_assert(&out, "Modus_Thread_Record", size_of(op.Thread_Record))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "self", offset_of(op.Thread_Record, self))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "parameter", offset_of(op.Thread_Record, parameter))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "number", offset_of(op.Thread_Record, number))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "events", offset_of(op.Thread_Record, events))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "processors", offset_of(op.Thread_Record, processors))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "fault_written", offset_of(op.Thread_Record, fault_written))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "fault_read", offset_of(op.Thread_Record, fault_read))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "fault_full", offset_of(op.Thread_Record, fault_full))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "fault_reserved", offset_of(op.Thread_Record, fault_reserved))
	c_emit_offset_assert(&out, "Modus_Thread_Record", "fault_records", offset_of(op.Thread_Record, fault_records))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Thread_Registers {")
	fmt.sbprintln(&out, "\tuint64_t rax, rbx, rcx, rdx;")
	fmt.sbprintln(&out, "\tuint64_t rsi, rdi, rbp, rsp;")
	fmt.sbprintln(&out, "\tuint64_t r8, r9, r10, r11;")
	fmt.sbprintln(&out, "\tuint64_t r12, r13, r14, r15;")
	fmt.sbprintln(&out, "\tuint64_t rip;")
	fmt.sbprintln(&out, "\tuint64_t rflags;")
	fmt.sbprintln(&out, "\tuint64_t cs;")
	fmt.sbprintln(&out, "\tuint64_t ss;")
	fmt.sbprintln(&out, "\tuint64_t in_kernel_entry;")
	fmt.sbprintln(&out, "\tuint64_t reserved;")
	fmt.sbprintln(&out, "} Modus_Thread_Registers;")
	c_emit_size_assert(&out, "Modus_Thread_Registers", size_of(op.Thread_Registers))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "rax", offset_of(op.Thread_Registers, rax))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "rsp", offset_of(op.Thread_Registers, rsp))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "rip", offset_of(op.Thread_Registers, rip))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "rflags", offset_of(op.Thread_Registers, rflags))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "cs", offset_of(op.Thread_Registers, cs))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "ss", offset_of(op.Thread_Registers, ss))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "in_kernel_entry", offset_of(op.Thread_Registers, in_kernel_entry))
	c_emit_offset_assert(&out, "Modus_Thread_Registers", "reserved", offset_of(op.Thread_Registers, reserved))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Process_Module_Record {")
	fmt.sbprintln(&out, "\tuint64_t base;")
	fmt.sbprintln(&out, "\tuint64_t size;")
	fmt.sbprintln(&out, "\tuint8_t hash[32];")
	fmt.sbprintln(&out, "\tuint8_t replaces[32];")
	fmt.sbprintln(&out, "\tuint64_t writer;")
	fmt.sbprintln(&out, "} Modus_Process_Module_Record;")
	c_emit_size_assert(&out, "Modus_Process_Module_Record", size_of(op.Module_Record))
	c_emit_offset_assert(&out, "Modus_Process_Module_Record", "base", offset_of(op.Module_Record, base))
	c_emit_offset_assert(&out, "Modus_Process_Module_Record", "size", offset_of(op.Module_Record, size))
	c_emit_offset_assert(&out, "Modus_Process_Module_Record", "hash", offset_of(op.Module_Record, hash))
	c_emit_offset_assert(&out, "Modus_Process_Module_Record", "replaces", offset_of(op.Module_Record, replaces))
	c_emit_offset_assert(&out, "Modus_Process_Module_Record", "writer", offset_of(op.Module_Record, writer))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Stop_Frame {")
	fmt.sbprintln(&out, "\tuint64_t address;")
	fmt.sbprintln(&out, "\tuint64_t base;")
	fmt.sbprintln(&out, "\tuint8_t hash[32];")
	fmt.sbprintln(&out, "} Modus_Stop_Frame;")
	c_emit_size_assert(&out, "Modus_Stop_Frame", size_of(op.Stop_Frame))
	c_emit_offset_assert(&out, "Modus_Stop_Frame", "address", offset_of(op.Stop_Frame, address))
	c_emit_offset_assert(&out, "Modus_Stop_Frame", "base", offset_of(op.Stop_Frame, base))
	c_emit_offset_assert(&out, "Modus_Stop_Frame", "hash", offset_of(op.Stop_Frame, hash))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Stop_Report {")
	fmt.sbprintln(&out, "\tuint32_t cause;")
	fmt.sbprintln(&out, "\tuint32_t vector;")
	fmt.sbprintln(&out, "\tuint64_t instruction;")
	fmt.sbprintln(&out, "\tuint64_t address;")
	fmt.sbprintln(&out, "\tModus_Process_Module_Record module;")
	fmt.sbprintln(&out, "\tuint64_t frame_count;")
	fmt.sbprintfln(&out, "\tModus_Stop_Frame frames[%d];", op.STOP_FRAME_CAPACITY)
	fmt.sbprintln(&out, "\tuint64_t process_serial;")
	fmt.sbprintln(&out, "\tuint64_t hidden_value_count;")
	fmt.sbprintln(&out, "\tModus_Error_Record error;")
	fmt.sbprintln(&out, "} Modus_Stop_Report;")
	c_emit_size_assert(&out, "Modus_Stop_Report", size_of(op.Stop_Report))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "cause", offset_of(op.Stop_Report, cause))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "vector", offset_of(op.Stop_Report, vector))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "instruction", offset_of(op.Stop_Report, instruction))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "address", offset_of(op.Stop_Report, address))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "module", offset_of(op.Stop_Report, module))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "frame_count", offset_of(op.Stop_Report, frame_count))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "frames", offset_of(op.Stop_Report, frames))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "process_serial", offset_of(op.Stop_Report, process_serial))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "hidden_value_count", offset_of(op.Stop_Report, hidden_value_count))
	c_emit_offset_assert(&out, "Modus_Stop_Report", "error", offset_of(op.Stop_Report, error))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Context {")
	fmt.sbprintfln(&out, "\tModus_Handle handles[%d];", op.CONTEXT_HANDLES)
	fmt.sbprintfln(&out, "\tuint64_t values[%d];", op.CONTEXT_VALUES)
	fmt.sbprintln(&out, "} Modus_Context;")
	c_emit_size_assert(&out, "Modus_Context", size_of(op.Context))
	c_emit_offset_assert(&out, "Modus_Context", "handles", offset_of(op.Context, handles))
	c_emit_offset_assert(&out, "Modus_Context", "values", offset_of(op.Context, values))
	fmt.sbprintln(&out)

	c_header_end(&out, "MODUS_OPERATION_H")
	return strings.to_string(out)
}

@(private = "file")
c_render_modus_module_h :: proc(allocator := context.temp_allocator) -> string {
	out := strings.builder_make(allocator)
	c_header_begin(&out, "MODUS_MODULE_H", "modus_module.h - Module binary format contract for modus", {"\"modus_types.h\""})

	fmt.sbprintfln(&out, "#define MODUS_MODULE_MAGIC ((uint64_t)0x%016XULL)", module.MAGIC)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_VERSION ((uint32_t)%dU)", module.VERSION)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_PAGE_SIZE ((uint64_t)%dULL)", module.PAGE_SIZE)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_HASH_SIZE ((uint32_t)%dU)", module.HASH_SIZE)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_UNDERSTOOD_FEATURES ((uint64_t)0x%016XULL)", module.UNDERSTOOD_FEATURES)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_TABLE_COUNT ((uint32_t)%dU)", module.TABLE_COUNT)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_PARAMETER_CAPACITY ((uint32_t)%dU)", module.PARAMETER_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_RECORD_SIZE_LIMIT ((uint32_t)%dU)", module.RECORD_SIZE_LIMIT)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_HANDLE_CAPACITY ((uint32_t)%dU)", module.HANDLE_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_REBASE_WORD_SIZE ((uint32_t)%dU)", module.REBASE_WORD_SIZE)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_REBASE_BITMAP_LOCATIONS ((uint32_t)%dU)", module.REBASE_BITMAP_LOCATIONS)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_FACT_TEMPLATE_BYTES_MOST ((uint32_t)%dU)", module.FACT_TEMPLATE_BYTES_MOST)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_ENUM_MEMBER_CAPACITY ((uint32_t)%dU)", module.ENUM_MEMBER_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_ENUM_MEMBER_NAME_CAPACITY ((uint32_t)%dU)", module.ENUM_MEMBER_NAME_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_MEMBER_TEXT_CAPACITY ((uint32_t)%dU)", module.MEMBER_TEXT_CAPACITY)
	fmt.sbprintfln(&out, "#define MODUS_MODULE_RECORD_STREAM_INDEX_MOST ((uint32_t)%dU)", module.RECORD_STREAM_INDEX_MOST)
	fmt.sbprintln(&out)

	c_emit_enum_u32(&out, "Modus_Module_Machine", "MODUS_MODULE_MACHINE", module.Machine)
	c_emit_enum_u32(&out, "Modus_Module_Table_Kind", "MODUS_MODULE_TABLE_KIND", module.Table_Kind)
	c_emit_enum_u32(&out, "Modus_Module_Segment_Flag", "MODUS_MODULE_SEGMENT_FLAG", module.Segment_Flag)
	c_emit_enum_u8(&out, "Modus_Module_Type", "MODUS_MODULE_TYPE", module.Type)
	c_emit_enum_u8(&out, "Modus_Module_Direction", "MODUS_MODULE_DIRECTION", module.Direction)
	c_emit_enum_u8(&out, "Modus_Module_Record_Output_Pairing", "MODUS_MODULE_RECORD_OUTPUT_PAIRING", module.Record_Output_Pairing)
	c_emit_enum_u8(&out, "Modus_Module_Wiring_Count", "MODUS_MODULE_WIRING_COUNT", module.Wiring_Count)
	c_emit_enum_u8(&out, "Modus_Module_Category", "MODUS_MODULE_CATEGORY", module.Module_Category)
	c_emit_enum_u8(&out, "Modus_Module_Tag", "MODUS_MODULE_TAG", module.Module_Tag)

	fmt.sbprintln(&out, "typedef uint32_t Modus_Module_Segment_Flags;")
	c_emit_size_assert(&out, "Modus_Module_Segment_Flags", size_of(module.Segment_Flags))
	// The tags: bit n is the tag n of Modus_Module_Tag.
	fmt.sbprintln(&out, "typedef uint16_t Modus_Module_Tags;")
	c_emit_size_assert(&out, "Modus_Module_Tags", size_of(module.Module_Tags))
	fmt.sbprintln(&out)

	fmt.sbprintln(&out, "typedef struct Modus_Module_Header {")
	fmt.sbprintln(&out, "\tuint64_t magic;")
	fmt.sbprintln(&out, "\tuint32_t version;")
	fmt.sbprintln(&out, "\tuint32_t header_size;")
	fmt.sbprintln(&out, "\tuint64_t must_understand;")
	fmt.sbprintln(&out, "\tModus_Module_Machine machine;")
	fmt.sbprintln(&out, "\tuint32_t table_count;")
	fmt.sbprintln(&out, "\tuint64_t memory_size;")
	fmt.sbprintln(&out, "\tuint32_t entry_export;")
	fmt.sbprintln(&out, "\tModus_Module_Category category;")
	fmt.sbprintln(&out, "\tuint8_t reserved;")
	fmt.sbprintln(&out, "\tModus_Module_Tags tags;")
	fmt.sbprintln(&out, "} Modus_Module_Header;")
	c_emit_size_assert(&out, "Modus_Module_Header", size_of(module.Header))
	c_emit_offset_assert(&out, "Modus_Module_Header", "magic", offset_of(module.Header, magic))
