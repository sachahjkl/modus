# zstd on modus: the files of the format, with the configuration of modus in
# place of lib/common/zstd_deps.h, and each context over a heap that the
# caller lends. The hash is the one that Nixpkgs pins for this archive.
recipe: zstd
version: 1.5.7
source: https://dev-www.libreoffice.org/src/zstd-1.5.7.tar.gz
source_hash: sha256-6zPlH0mhXgI5UM14Jcp0pKK0Pbg1SCWsJPwbfuCeb6M=
unpack: tar.gz
root: zstd-1.5.7/lib
patch: zstd/patches/0001-read-no-cpuid-on-modus.patch
force_include: zstd/modus_zstd_conf.h
compile: common/debug.c
compile: common/entropy_common.c
compile: common/error_private.c
compile: common/fse_decompress.c
compile: common/pool.c
compile: common/threading.c
compile: common/xxhash.c
compile: common/zstd_common.c
compile: compress/fse_compress.c
compile: compress/hist.c
compile: compress/huf_compress.c
compile: compress/zstd_compress.c
compile: compress/zstd_compress_literals.c
compile: compress/zstd_compress_sequences.c
compile: compress/zstd_compress_superblock.c
compile: compress/zstd_double_fast.c
compile: compress/zstd_fast.c
compile: compress/zstd_lazy.c
compile: compress/zstd_ldm.c
compile: compress/zstd_opt.c
compile: compress/zstd_preSplit.c
compile: decompress/huf_decompress.c
compile: decompress/zstd_ddict.c
compile: decompress/zstd_decompress.c
compile: decompress/zstd_decompress_block.c
adapter: thin_libc/modus_thin_libc.c
adapter: thin_libc/modus_thin_libc_memory.c
adapter: thin_libc/modus_thin_libc_math.c
adapter: zstd/modus_zstd_entry.c
manifest: zstd/zstd.manifest
include: zstd
flag: --target=x86_64-unknown-none-elf
flag: -std=gnu11
flag: -O2
flag: -ffreestanding
flag: -nostdinc
flag: -fPIC
flag: -fvisibility=hidden
flag: -fno-omit-frame-pointer
flag: -mno-omit-leaf-frame-pointer
flag: -mlong-double-64
flag: -fno-stack-protector
flag: -fno-stack-clash-protection
flag: -fcf-protection=none
flag: -fzero-call-used-regs=skip
flag: -U_FORTIFY_SOURCE
flag: -fno-asynchronous-unwind-tables
flag: -fno-unwind-tables
flag: -fno-common
include: thin_libc/include
include: thin_libc
test: compress and decompress empty, small, repetitive, random and multi-block payloads at levels from -5 to 19, and compare the bytes
test: decompress the frames of the zstd of the host, and give the zstd of the host frames that it decompresses
test: refuse a damaged frame, a cut frame, a wrong magic number and an output too small, with the code of zstd
