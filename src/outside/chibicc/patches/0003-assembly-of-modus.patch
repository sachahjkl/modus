+// modus: the data is one section, `section data`, of `byte`, `quad` and
+// `zero` lines. An address is a `quad` of its label, which the module
+// rebases at its load. The assembler of modus has no alignment directive: the section
+// starts on a page, so this count of its bytes gives the padding of each
+// variable. A variable with no initializer is zero bytes, which the module
+// file does not store at the end of the section.
+static long data_offset;
+
+// modus: an object has no token of its own; the name of its type is the
+// place of its declaration, and an object with no name (a string, a
+// compound literal) is named by its label.
+static noreturn void refuse_object(Obj *var, Token *name, char *message) {
+  if (name)
+    error_tok(name, "%s", message);
+  error("%s: %s", var->name, message);
+}
