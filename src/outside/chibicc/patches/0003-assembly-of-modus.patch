+// modus: an int or a long is an Integer of an export, in one register of
+// 64 bits.
+static bool is_export_integer(Type *ty) {
+  return (ty->kind == TY_INT || ty->kind == TY_LONG) && !ty->is_unsigned;
+}
+
+// modus: a function that is not static has external linkage, so other
+// code calls it: it is an export of the module, with its types.
+static void export_directive(Obj *fn) {
+  Type *result = fn->ty->return_ty;
+  if (result->kind != TY_VOID && !is_export_integer(result))
+    refuse_object(fn, fn->ty->name, "a function that is not static is an export, and gives an int, a long or nothing: make it static, or give it one of those");
+  if (fn->ty->is_variadic)
+    refuse_object(fn, fn->ty->name, "a function that is not static is an export, and takes a fixed count of parameters: make it static");
+  for (Obj *var = fn->params; var; var = var->next)
+    if (!is_export_integer(var->ty))
+      refuse_object(var, var->ty->name, "a parameter of a function that is not static is an int or a long: make the function static, or give the parameter one of those");
+
+  fprintf(output_file, "export %s(", fn->name);
+  for (Obj *var = fn->params; var; var = var->next)
+    fprintf(output_file, "%s%s: Integer", var == fn->params ? "" : ", ", var->name);
+  fprintf(output_file, ")");
+  if (result->kind != TY_VOID)
+    fprintf(output_file, " -> Integer");
+  fprintf(output_file, "\n");
+}
