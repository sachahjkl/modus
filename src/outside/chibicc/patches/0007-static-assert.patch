+// modus: C11 _Static_assert(constant-expression, string-literal) in file,
+// block, or struct scope (used by zstd and SQLite).
+static Token *parse_static_assert(Token *tok) {
+  Token *start = tok;
+  tok = skip(tok->next, "(");
+  int64_t val = const_expr(&tok, tok);
+  if (consume(&tok, tok, ",")) {
+    if (tok->kind != TK_STR)
+      error_tok(tok, "expected string literal");
+    tok = tok->next;
+  }
+  tok = skip(tok, ")");
+  tok = skip(tok, ";");
+  if (!val)
+    error_tok(start, "static assertion failed");
+  return tok;
+}
