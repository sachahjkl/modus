#+build !freestanding
package text_rendering

import "core:testing"
import "modus:vector_font"

// The shaper of the scripts of India (indic.odin) against HarfBuzz, for
// the scripts past Devanagari (devanagari_test.odin). The expected glyphs
// come from HarfBuzz 12.3.0, through uharfbuzz 0.53.2 of nixpkgs, on the
// files of noto-fonts 2026.05.01 that the script font set holds: for each
// word, each glyph index, its advance and its offset, in units of the
// font. The clusters are not compared: HarfBuzz merges more of them.

@(private = "file")
Script_Glyph :: struct {
	glyph, advance, x_offset, y_offset: i32,
}

@(private = "file")
Script_Word :: struct {
	word:   string,
	glyphs: []Script_Glyph,
}

@(private = "file")
Script_Words :: struct {
	font:  string,
	words: []Script_Word,
}

@(private = "file")
