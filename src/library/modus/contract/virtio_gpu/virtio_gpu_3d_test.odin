#+build !freestanding
package virtio_gpu

import "core:testing"
import "modus:contract/byte_order"

// The command words and the sizes of the Linux header virtio_gpu.h: a wrong
// word or size makes the host refuse every command of the context.
#assert(u32(Command_Type.Get_Capset_Info) == 0x0108)
#assert(u32(Command_Type.Get_Capset) == 0x0109)
#assert(u32(Command_Type.Resource_Create_Blob) == 0x010C)
#assert(u32(Command_Type.Set_Scanout_Blob) == 0x010D)
#assert(u32(Command_Type.Ctx_Create) == 0x0200)
#assert(u32(Command_Type.Ctx_Destroy) == 0x0201)
#assert(u32(Command_Type.Ctx_Attach_Resource) == 0x0202)
#assert(u32(Command_Type.Ctx_Detach_Resource) == 0x0203)
#assert(u32(Command_Type.Submit_3D) == 0x0207)
#assert(u32(Command_Type.Resource_Map_Blob) == 0x0208)
#assert(u32(Command_Type.Resource_Unmap_Blob) == 0x0209)
#assert(u32(Command_Type.Response_Ok_Capset) == 0x1103)
#assert(u32(Command_Type.Response_Ok_Map_Info) == 0x1106)
#assert(u32(Capset_Id.Venus) == 4)
#assert(CTRL_HEADER_SIZE == 24)
#assert(GET_CAPSET_INFO_SIZE == 32)
#assert(RESP_CAPSET_INFO_SIZE == 40)
#assert(GET_CAPSET_SIZE == 32)
#assert(CTX_CREATE_SIZE == 96)
#assert(CTX_DESTROY_SIZE == 24)
#assert(CTX_RESOURCE_SIZE == 32)
#assert(RESOURCE_CREATE_BLOB_SIZE == 56)
#assert(RESOURCE_MAP_BLOB_SIZE == 40)
#assert(RESP_MAP_INFO_SIZE == 32)
#assert(RESOURCE_UNMAP_BLOB_SIZE == 32)
#assert(SUBMIT_3D_HEADER_SIZE == 32)

@(test)
capset_and_context_resource_commands :: proc(t: ^testing.T) {
	wire: [4096]u8

	// Get_Capset: the offsets of capset_id and capset_version, unknown capset refused.
	_, gc_bad := get_capset_encode(Capset_Id(99), 1, wire[:])
	testing.expect_value(t, gc_bad, Validation_Problem.Unknown_Capset_Id)
	_, gc_short := get_capset_encode(.Venus, 1, wire[:GET_CAPSET_SIZE - 1])
	testing.expect_value(t, gc_short, Validation_Problem.Buffer_Too_Short)
	w_gc, gc_ok := get_capset_encode(.Venus, 1, wire[:])
	testing.expect_value(t, gc_ok, Validation_Problem.None)
	testing.expect_value(t, w_gc, GET_CAPSET_SIZE)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 0), u32(0x0109))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 24), u32(4))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 28), u32(1))
	dec_gc, dec_gc_prob := get_capset_decode(wire[:w_gc])
	testing.expect_value(t, dec_gc_prob, Validation_Problem.None)
	testing.expect_value(t, dec_gc.capset_id, Capset_Id.Venus)
	testing.expect_value(t, dec_gc.capset_version, u32(1))
	byte_order.write_u32_little_endian(wire[:], 24, 0)
	_, dec_gc_bad := get_capset_decode(wire[:w_gc])
	testing.expect_value(t, dec_gc_bad, Validation_Problem.Unknown_Capset_Id)

	// Response_Ok_Capset: data slice, error response, wrong type, oversized data.
	capset_bytes := [8]u8{1, 0, 0, 0, 2, 0, 0, 0}
	w_cr, cr_ok := capset_response_encode(Ctrl_Header{}, capset_bytes[:], wire[:])
	testing.expect_value(t, cr_ok, Validation_Problem.None)
	testing.expect_value(t, w_cr, CTRL_HEADER_SIZE + 8)
	dec_cr, dec_cr_prob := capset_response_decode(wire[:w_cr])
	testing.expect_value(t, dec_cr_prob, Validation_Problem.None)
	testing.expect_value(t, len(dec_cr.data), 8)
	testing.expect_value(t, dec_cr.data[4], u8(2))
	too_large: [MAX_CAPSET_DATA_BYTES + 1]u8
	big_wire: [CTRL_HEADER_SIZE + MAX_CAPSET_DATA_BYTES + 1]u8
	_, cr_large := capset_response_encode(Ctrl_Header{}, too_large[:], big_wire[:])
	testing.expect_value(t, cr_large, Validation_Problem.Capset_Data_Too_Large)
	_, _ = ctrl_header_encode(Ctrl_Header{command_type = .Response_Ok_Capset}, big_wire[:])
	_, dec_large := capset_response_decode(big_wire[:])
	testing.expect_value(t, dec_large, Validation_Problem.Capset_Data_Too_Large)
	_, _ = ctrl_header_encode(Ctrl_Header{command_type = .Response_Err_Invalid_Parameter}, wire[:])
	_, dec_cr_err := capset_response_decode(wire[:CTRL_HEADER_SIZE])
	testing.expect_value(t, dec_cr_err, Validation_Problem.Device_Error_Response)
	_, _ = ctrl_header_encode(Ctrl_Header{command_type = .Response_Ok_Nodata}, wire[:])
	_, dec_cr_type := capset_response_decode(wire[:CTRL_HEADER_SIZE])
	testing.expect_value(t, dec_cr_type, Validation_Problem.Unexpected_Response_Type)

	// Ctx_Attach_Resource and Ctx_Detach_Resource: zero ids, padding, wrong type.
	_, ca0 := ctx_attach_resource_encode(0, 5, wire[:])
	testing.expect_value(t, ca0, Validation_Problem.Zero_Context_Id)
	_, ca1 := ctx_attach_resource_encode(3, 0, wire[:])
	testing.expect_value(t, ca1, Validation_Problem.Zero_Resource_Id)
	_, ca2 := ctx_attach_resource_encode(3, 5, wire[:CTX_RESOURCE_SIZE - 1])
	testing.expect_value(t, ca2, Validation_Problem.Buffer_Too_Short)
	w_ca, ca_ok := ctx_attach_resource_encode(3, 5, wire[:])
	testing.expect_value(t, ca_ok, Validation_Problem.None)
	testing.expect_value(t, w_ca, CTX_RESOURCE_SIZE)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 0), u32(0x0202))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 16), u32(3))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 24), u32(5))
	dec_ca, dec_ca_prob := ctx_resource_decode(wire[:w_ca])
	testing.expect_value(t, dec_ca_prob, Validation_Problem.None)
	testing.expect_value(t, dec_ca.header.command_type, Command_Type.Ctx_Attach_Resource)
	testing.expect_value(t, dec_ca.resource_id, u32(5))
	wire[28] = 1
	_, dec_ca_pad := ctx_resource_decode(wire[:w_ca])
	testing.expect_value(t, dec_ca_pad, Validation_Problem.Non_Zero_Padding)
	w_cd, cd_ok := ctx_detach_resource_encode(3, 5, wire[:])
	testing.expect_value(t, cd_ok, Validation_Problem.None)
	dec_cd, dec_cd_prob := ctx_resource_decode(wire[:w_cd])
	testing.expect_value(t, dec_cd_prob, Validation_Problem.None)
	testing.expect_value(t, dec_cd.header.command_type, Command_Type.Ctx_Detach_Resource)
	_, _ = ctx_destroy_encode(3, wire[:])
	_, dec_cd_type := ctx_resource_decode(wire[:CTX_RESOURCE_SIZE])
	testing.expect_value(t, dec_cd_type, Validation_Problem.Unexpected_Response_Type)
	dec_destroy, dec_destroy_prob := ctx_destroy_decode(wire[:CTX_DESTROY_SIZE])
	testing.expect_value(t, dec_destroy_prob, Validation_Problem.None)
	testing.expect_value(t, dec_destroy.ctx_id, u32(3))
	byte_order.write_u32_little_endian(wire[:], 16, 0)
	_, dec_destroy_zero := ctx_destroy_decode(wire[:CTX_DESTROY_SIZE])
	testing.expect_value(t, dec_destroy_zero, Validation_Problem.Zero_Context_Id)
}

@(test)
blob_creation_mapping_and_submit_header :: proc(t: ^testing.T) {
	wire: [4096]u8

	// Resource_Create_Blob rules: host blobs need a context and no guest pages,
	// guest blobs need guest pages.
	_, rule0 := resource_create_blob_encode(0, 5, .Host3D, {.Use_Mappable}, 0, 0, 4096, wire[:])
	testing.expect_value(t, rule0, Validation_Problem.Zero_Context_Id)
	_, rule1 := resource_create_blob_encode(3, 5, .Host3D, {.Use_Mappable}, 1, 0, 4096, wire[:])
	testing.expect_value(t, rule1, Validation_Problem.Blob_Entries_Invalid)
	_, rule2 := resource_create_blob_encode(0, 5, .Guest, {}, 0, 0, 4096, wire[:])
	testing.expect_value(t, rule2, Validation_Problem.Blob_Entries_Invalid)
	_, rule3 := resource_create_blob_encode(3, 5, .Host3D_Guest, {}, 0, 0, 4096, wire[:])
	testing.expect_value(t, rule3, Validation_Problem.Blob_Entries_Invalid)
	_, rule4 := resource_create_blob_encode(3, 5, .Host3D, transmute(Blob_Flags)u32(0x8), 0, 0, 4096, wire[:])
	testing.expect_value(t, rule4, Validation_Problem.Unknown_Blob_Flags)
	w_blob, blob_ok := resource_create_blob_encode(3, 5, .Host3D, {.Use_Mappable}, 0, 0, 65536, wire[:])
	testing.expect_value(t, blob_ok, Validation_Problem.None)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 0), u32(0x010C))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 28), u32(2))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 32), u32(1))
	testing.expect_value(t, byte_order.read_u64_little_endian(wire[:], 48), u64(65536))
	byte_order.write_u32_little_endian(wire[:], 36, 2)
	_, dec_rule := resource_create_blob_decode(wire[:w_blob])
	testing.expect_value(t, dec_rule, Validation_Problem.Blob_Entries_Invalid)

	// Resource_Map_Blob: zero id, offset off a page, padding, roundtrip.
	_, mb0 := resource_map_blob_encode(0, 0, wire[:])
	testing.expect_value(t, mb0, Validation_Problem.Zero_Resource_Id)
	_, mb1 := resource_map_blob_encode(5, 1, wire[:])
	testing.expect_value(t, mb1, Validation_Problem.Misaligned_Offset)
	_, mb2 := resource_map_blob_encode(5, MAP_BLOB_OFFSET_ALIGNMENT - 1, wire[:])
	testing.expect_value(t, mb2, Validation_Problem.Misaligned_Offset)
	_, mb3 := resource_map_blob_encode(5, 0, wire[:RESOURCE_MAP_BLOB_SIZE - 1])
	testing.expect_value(t, mb3, Validation_Problem.Buffer_Too_Short)
	w_mb, mb_ok := resource_map_blob_encode(5, 2 * MAP_BLOB_OFFSET_ALIGNMENT, wire[:])
	testing.expect_value(t, mb_ok, Validation_Problem.None)
	testing.expect_value(t, w_mb, RESOURCE_MAP_BLOB_SIZE)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 0), u32(0x0208))
	testing.expect_value(t, byte_order.read_u64_little_endian(wire[:], 32), u64(2 * MAP_BLOB_OFFSET_ALIGNMENT))
	dec_mb, dec_mb_prob := resource_map_blob_decode(wire[:w_mb])
	testing.expect_value(t, dec_mb_prob, Validation_Problem.None)
	testing.expect_value(t, dec_mb.resource_id, u32(5))
	testing.expect_value(t, dec_mb.offset, u64(2 * MAP_BLOB_OFFSET_ALIGNMENT))
	wire[30] = 1
	_, dec_mb_pad := resource_map_blob_decode(wire[:w_mb])
	testing.expect_value(t, dec_mb_pad, Validation_Problem.Non_Zero_Padding)
	wire[30] = 0
	byte_order.write_u64_little_endian(wire[:], 32, 7)
	_, dec_mb_off := resource_map_blob_decode(wire[:w_mb])
	testing.expect_value(t, dec_mb_off, Validation_Problem.Misaligned_Offset)

	// Response_Ok_Map_Info: every cache type, unknown cache words and reserved bits.
	for cache in Map_Cache {
		w_mi, mi_ok := map_info_response_encode(Map_Info_Response{cache = cache}, wire[:])
		testing.expect_value(t, mi_ok, Validation_Problem.None)
		testing.expect_value(t, w_mi, RESP_MAP_INFO_SIZE)
		dec_mi, dec_mi_prob := map_info_response_decode(wire[:w_mi])
		testing.expect_value(t, dec_mi_prob, Validation_Problem.None)
		testing.expect_value(t, dec_mi.cache, cache)
	}
	for word in ([]u32{4, 0x0F, 0x10, 0x13, max(u32)}) {
		_, ok := map_cache_of_word(word)
		testing.expectf(t, !ok, "map_info word 0x%x must be refused", word)
		byte_order.write_u32_little_endian(wire[:], 24, word)
		_, dec_word := map_info_response_decode(wire[:RESP_MAP_INFO_SIZE])
		testing.expect_value(t, dec_word, Validation_Problem.Unknown_Map_Cache)
	}
	byte_order.write_u32_little_endian(wire[:], 24, 1)
	_, dec_mi_short := map_info_response_decode(wire[:RESP_MAP_INFO_SIZE - 1])
	testing.expect_value(t, dec_mi_short, Validation_Problem.Buffer_Too_Short)
	byte_order.write_u32_little_endian(wire[:], 28, 1)
	_, dec_mi_pad := map_info_response_decode(wire[:RESP_MAP_INFO_SIZE])
	testing.expect_value(t, dec_mi_pad, Validation_Problem.Non_Zero_Padding)
	_, mi_bad := map_info_response_encode(Map_Info_Response{cache = Map_Cache(9)}, wire[:])
	testing.expect_value(t, mi_bad, Validation_Problem.Unknown_Map_Cache)
	_, _ = ctrl_header_encode(Ctrl_Header{command_type = .Response_Err_Out_Of_Memory}, wire[:])
	_, dec_mi_err := map_info_response_decode(wire[:CTRL_HEADER_SIZE])
	testing.expect_value(t, dec_mi_err, Validation_Problem.Device_Error_Response)

	// Resource_Unmap_Blob.
	_, ub0 := resource_unmap_blob_encode(0, wire[:])
	testing.expect_value(t, ub0, Validation_Problem.Zero_Resource_Id)
	w_ub, ub_ok := resource_unmap_blob_encode(5, wire[:])
	testing.expect_value(t, ub_ok, Validation_Problem.None)
	testing.expect_value(t, w_ub, RESOURCE_UNMAP_BLOB_SIZE)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 0), u32(0x0209))
	dec_ub, dec_ub_prob := resource_unmap_blob_decode(wire[:w_ub])
	testing.expect_value(t, dec_ub_prob, Validation_Problem.None)
	testing.expect_value(t, dec_ub.resource_id, u32(5))
	byte_order.write_u32_little_endian(wire[:], 24, 0)
	_, dec_ub_zero := resource_unmap_blob_decode(wire[:w_ub])
	testing.expect_value(t, dec_ub_zero, Validation_Problem.Zero_Resource_Id)

	// Submit_3D header: size at 24, padding at 28 refused when not zero, edges of the size.
	_, sh0 := submit_3d_header_encode(3, 0, wire[:])
	testing.expect_value(t, sh0, Validation_Problem.Submit_Size_Invalid)
	_, sh1 := submit_3d_header_encode(3, -4, wire[:])
	testing.expect_value(t, sh1, Validation_Problem.Submit_Size_Invalid)
	_, sh2 := submit_3d_header_encode(3, MAX_SUBMIT_3D_BYTES + 4, wire[:])
	testing.expect_value(t, sh2, Validation_Problem.Submit_Size_Invalid)
	_, sh3 := submit_3d_header_encode(3, 6, wire[:])
	testing.expect_value(t, sh3, Validation_Problem.Submit_Size_Invalid)
	_, sh4 := submit_3d_header_encode(0, 8, wire[:])
	testing.expect_value(t, sh4, Validation_Problem.Zero_Context_Id)
	w_sh, sh_ok := submit_3d_header_encode(3, 8, wire[:])
	testing.expect_value(t, sh_ok, Validation_Problem.None)
	testing.expect_value(t, w_sh, SUBMIT_3D_HEADER_SIZE)
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 24), u32(8))
	testing.expect_value(t, byte_order.read_u32_little_endian(wire[:], 28), u32(0))
	byte_order.write_u32_little_endian(wire[:], 28, 1)
	_, dec_sh_pad := submit_3d_decode(wire[:SUBMIT_3D_HEADER_SIZE + 8])
	testing.expect_value(t, dec_sh_pad, Validation_Problem.Non_Zero_Padding)
}

@(test)
venus_support_falls_back_to_two_d_scanout :: proc(t: ^testing.T) {
	virgl := u32(1 << FEATURE_VIRGL)
	blob := u32(1 << FEATURE_RESOURCE_BLOB)
	context_init := u32(1 << FEATURE_CONTEXT_INIT)
	// A 2D-only device offers no 3D feature: the service keeps the scanout only.
	testing.expect_value(t, venus_support_check(0, false), Venus_Support.No_Virgl_Feature)
	testing.expect_value(t, venus_support_check(0, true), Venus_Support.No_Virgl_Feature)
	testing.expect_value(t, venus_support_check(u32(1 << FEATURE_EDID), false), Venus_Support.No_Virgl_Feature)
	testing.expect_value(t, venus_support_check(virgl, true), Venus_Support.No_Resource_Blob_Feature)
	testing.expect_value(t, venus_support_check(virgl | blob, true), Venus_Support.No_Context_Init_Feature)
	testing.expect_value(t, venus_support_check(virgl | context_init, true), Venus_Support.No_Resource_Blob_Feature)
	testing.expect_value(t, venus_support_check(virgl | blob | context_init, false), Venus_Support.No_Venus_Capset)
	testing.expect_value(t, venus_support_check(blob | context_init, true), Venus_Support.No_Virgl_Feature)
	testing.expect_value(t, venus_support_check(virgl | blob | context_init, true), Venus_Support.Available)
	testing.expect_value(t, venus_support_check(max(u32), true), Venus_Support.Available)
}
